root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{hpp,cpp,h,c,cmake}]
indent_style = space
indent_size = 4
max_line_length = 110

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 4
